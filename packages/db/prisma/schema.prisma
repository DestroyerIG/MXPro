// Schema do banco da MXPro (docs/arquitetura.md §5.2).
// Fundação: usuários e perfis, sessões de login e configurações da marca.
// Fase 2: campeonatos, eventos (etapas), catálogo de categorias, categorias do evento e baterias.
// Fase 3: regras da prova versionadas. Fase 4: inscrições, pagamentos Pix e consentimentos (LGPD).
// Convenções: tabelas e colunas em snake_case no banco (@@map/@map), camelCase no código;
// datas em UTC (timestamptz); ids UUID.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Perfis de acesso (docs/arquitetura.md §1). A autorização é checada no backend em toda rota.
enum Role {
  ORGANIZER
  SECRETARY
  TIMEKEEPER
  PILOT
}

/// Como o nome do piloto aparece em páginas públicas e no telão (LGPD, §5.7).
enum PublicNameDisplay {
  FULL_NAME
  INITIALS
}

model User {
  id                 String               @id @default(uuid(7)) @db.Uuid
  /// Sempre gravado em minúsculas (normalizado pela API).
  email              String               @unique
  name               String
  /// Hash argon2id. A senha em texto nunca é armazenada.
  passwordHash       String               @map("password_hash")
  role               Role
  /// Usuário desativado não consegue logar e perde as sessões abertas.
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  raceConfigVersions RaceConfigVersion[]
  mercadoPagoAccount MercadoPagoAccount[]
  oauthStates        OAuthState[]
  /// Inscrições do usuário como PILOTO.
  registrations      Registration[]       @relation("RegistrationPilot")
  /// Vistorias feitas pelo usuário (secretaria/organizador).
  inspections        Registration[]       @relation("RegistrationInspector")
  consents           Consent[]

  @@map("users")
}

/// Sessão de login (cookie httpOnly). Guardamos só o HASH do token: quem ler o banco não consegue
/// se passar pelo usuário. Logout ou bloqueio = apagar a linha, com efeito imediato.
model Session {
  /// SHA-256 (hex) do token enviado no cookie.
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")
  ip         String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Configurações do contratante (sistema single-tenant: existe UMA linha, id = 1).
/// Identidade visual aplicada em telas públicas, telão e PDFs (§2.7).
model Settings {
  id                Int               @id @default(1)
  brandName         String            @map("brand_name")
  /// Trecho inicial do nome destacado na cor da marca quando não há logo (ex.: "MX").
  brandNameAccent   String?           @map("brand_name_accent")
  /// Cor principal em #RRGGBB. O front deriva os demais tons com contraste AA.
  primaryColor      String            @map("primary_color")
  logoUrl           String?           @map("logo_url")
  publicNameDisplay PublicNameDisplay @default(FULL_NAME) @map("public_name_display")
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

// ─── Fase 2: eventos e categorias ───────────────────────────────────────────────────────────

/// Modalidades do escopo (§4.7). Fica na CATEGORIA do evento: um mesmo evento pode ter
/// Motocross e Cross Country (ex.: Copa Verão – Etapa 2).
enum Modality {
  MOTOCROSS
  ENDURO
  ENDURO_REGULARITY
  CROSS_COUNTRY
  SUPERCROSS
  CUSTOM
}

/// Ciclo de vida do evento. Evento com dados vinculados é CANCELADO, nunca apagado.
enum EventStatus {
  /// Em montagem: só a equipe vê.
  DRAFT
  /// Publicado: aparece para pilotos e público (inscrições seguem as datas).
  PUBLISHED
  FINISHED
  CANCELED
}

enum HeatStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELED
}

/// Campeonato (ex.: "Copa Verão de Motocross" 2027). Agrupa etapas para o ranking (fase 7).
model Championship {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  /// Temporada (ano). Nome + temporada identificam o campeonato.
  season    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  events    Event[]

  @@unique([name, season])
  @@map("championships")
}

/// Evento = um dia (ou mais) de prova. Pode ser uma etapa de campeonato ou avulso.
model Event {
  id                      String          @id @default(uuid(7)) @db.Uuid
  /// Nulo = evento avulso (fora de campeonato).
  championshipId          String?         @map("championship_id") @db.Uuid
  championship            Championship?   @relation(fields: [championshipId], references: [id], onDelete: Restrict)
  /// Número da etapa no campeonato (1, 2, 3…). Só existe quando há campeonato.
  stageNumber             Int?            @map("stage_number")
  name                    String
  /// Datas do calendário no fuso do evento (sem hora). Evento de vários dias: start < end.
  startDate               DateTime        @map("start_date") @db.Date
  endDate                 DateTime        @map("end_date") @db.Date
  /// Fuso IANA usado para exibir horários (datas no banco sempre em UTC).
  timeZone                String          @default("America/Sao_Paulo") @map("time_zone")
  /// Local da prova (ex.: "Pista Terra Vermelha").
  venue                   String
  city                    String
  /// UF com 2 letras maiúsculas.
  state                   String          @db.Char(2)
  status                  EventStatus     @default(DRAFT)
  /// Janela de inscrições. Fora dela (ou fechada manualmente) ninguém se inscreve.
  registrationOpensAt     DateTime?       @map("registration_opens_at") @db.Timestamptz(3)
  registrationClosesAt    DateTime?       @map("registration_closes_at") @db.Timestamptz(3)
  /// "Fechar inscrições agora" (ex.: vagas esgotadas), mesmo dentro da janela.
  registrationClosedEarly Boolean         @default(false) @map("registration_closed_early")
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  categories              EventCategory[]
  heats                   Heat[]
  registrations           Registration[]

  @@unique([championshipId, stageNumber])
  @@index([startDate])
  @@map("events")
}

/// Catálogo de categorias (MX1, MX2, Feminino…). A MESMA categoria em todas as etapas permite
/// somar pontos no campeonato. Categoria em uso não é apagada: é desativada.
model Category {
  id          String          @id @default(uuid(7)) @db.Uuid
  /// Único sem diferenciar maiúsculas (índice em lower(name) na migration).
  name        String
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  events      EventCategory[]

  @@map("categories")
}

/// Categoria disputada num evento: modalidade, valor da inscrição e vagas.
model EventCategory {
  id            String              @id @default(uuid(7)) @db.Uuid
  eventId       String              @map("event_id") @db.Uuid
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId    String              @map("category_id") @db.Uuid
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modality      Modality
  /// Valor da inscrição em CENTAVOS (dinheiro nunca em float).
  entryFeeCents Int                 @map("entry_fee_cents")
  /// Limite de inscritos. Nulo = sem limite.
  maxEntries    Int?                @map("max_entries")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  heats         HeatCategory[]
  raceConfigs   RaceConfigVersion[]
  registrations Registration[]

  @@unique([eventId, categoryId])
  /// Alvo da FK composta de HeatCategory (garante categoria e bateria do mesmo evento).
  @@unique([id, eventId])
  @@map("event_categories")
}

/// Bateria (largada). Pode juntar mais de uma categoria na pista; cada piloto é classificado na sua.
model Heat {
  id          String         @id @default(uuid(7)) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Nome exibido (ex.: "Bateria 1", "Final").
  name        String
  /// Horário previsto da largada (UTC). Nulo = a definir.
  scheduledAt DateTime?      @map("scheduled_at") @db.Timestamptz(3)
  status      HeatStatus     @default(SCHEDULED)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  categories  HeatCategory[]

  @@unique([id, eventId])
  @@index([eventId, scheduledAt])
  @@map("heats")
}

/// Categorias que largam numa bateria. O event_id repetido aqui é de propósito: com as FKs
/// compostas, o BANCO recusa ligar uma bateria a uma categoria de outro evento.
model HeatCategory {
  heatId          String        @map("heat_id") @db.Uuid
  eventCategoryId String        @map("event_category_id") @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  heat            Heat          @relation(fields: [heatId, eventId], references: [id, eventId], onDelete: Cascade)
  eventCategory   EventCategory @relation(fields: [eventCategoryId, eventId], references: [id, eventId], onDelete: NoAction)

  @@id([heatId, eventCategoryId])
  @@index([eventCategoryId])
  @@map("heat_categories")
}

// ─── Fase 3: regras da prova ────────────────────────────────────────────────────────────────

/// Configuração da prova de uma categoria do evento (JSON versionado do motor de regras).
/// Antes da largada, salvar atualiza a versão atual. Depois que alguma bateria da categoria começa,
/// a configuração fica CONGELADA: mudar exige motivo e cria uma nova versão (a anterior fica guardada).
model RaceConfigVersion {
  id              String        @id @default(uuid(7)) @db.Uuid
  eventCategoryId String        @map("event_category_id") @db.Uuid
  eventCategory   EventCategory @relation(fields: [eventCategoryId], references: [id], onDelete: Cascade)
  /// 1, 2, 3… por categoria do evento.
  version         Int
  /// Configuração validada pelo motor de regras (`schemaVersion` dentro do próprio JSON).
  config          Json
  /// Obrigatório nas versões criadas depois da largada (auditoria).
  reason          String?
  createdById     String?       @map("created_by_id") @db.Uuid
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([eventCategoryId, version])
  @@map("race_config_versions")
}

// ─── Fase 4: inscrições e pagamentos ────────────────────────────────────────────────────────
// Decisões no ADR 0004 (docs/decisions/0004-inscricoes-e-pix.md).

enum RegistrationStatus {
  /// Aguardando o Pix. A vaga (e o nº de largada) fica reservada até `holdExpiresAt`.
  PENDING_PAYMENT
  /// Pagamento confirmado pelo webhook do gateway (ou baixa manual auditada).
  CONFIRMED
  /// O Pix venceu sem pagamento: vaga e número voltam a ficar livres.
  EXPIRED
  /// Cancelada pela organização (ou desistência). Mantida para histórico e financeiro.
  CANCELED
}

/// Vistoria da moto e do equipamento no dia da prova (check-in da secretaria).
enum InspectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
  CANCELED
}

/// Documentos aceitos pelo piloto (LGPD, docs/arquitetura.md §2.8).
enum ConsentKind {
  /// Política de privacidade: aceita ao criar a conta.
  PRIVACY_POLICY
  /// Termo de responsabilidade: aceito em CADA inscrição.
  LIABILITY_WAIVER
}

/// Inscrição de um piloto numa categoria do evento. Um piloto pode correr mais de uma categoria
/// no mesmo evento: cada uma é uma inscrição, com seu pagamento e seu nº de largada.
model Registration {
  id               String             @id @default(uuid(7)) @db.Uuid
  eventId          String             @map("event_id") @db.Uuid
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventCategoryId  String             @map("event_category_id") @db.Uuid
  /// FK composta: o BANCO garante que a categoria é deste evento.
  eventCategory    EventCategory      @relation(fields: [eventCategoryId, eventId], references: [id, eventId], onDelete: Restrict)
  pilotId          String             @map("pilot_id") @db.Uuid
  pilot            User               @relation("RegistrationPilot", fields: [pilotId], references: [id], onDelete: Restrict)
  /// Nº de largada como TEXTO ("05" e "5" são placas diferentes), de 1 a 3 dígitos.
  /// Único por categoria do evento entre as inscrições ativas (índice parcial na migration).
  raceNumber       String             @map("race_number") @db.VarChar(3)
  /// Moto (ex.: "Honda CRF 250F").
  bike             String
  team             String?
  status           RegistrationStatus @default(PENDING_PAYMENT)
  /// Valor cobrado em CENTAVOS, copiado da categoria na hora da inscrição: mudar o preço
  /// depois não altera inscrições já feitas.
  entryFeeCents    Int                @map("entry_fee_cents")
  /// Vaga reservada até aqui enquanto aguarda o Pix (30 min). Nulo fora de PENDING_PAYMENT.
  holdExpiresAt    DateTime?          @map("hold_expires_at") @db.Timestamptz(3)
  confirmedAt      DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  inspectionStatus InspectionStatus   @default(PENDING) @map("inspection_status")
  inspectedAt      DateTime?          @map("inspected_at") @db.Timestamptz(3)
  inspectedById    String?            @map("inspected_by_id") @db.Uuid
  inspectedBy      User?              @relation("RegistrationInspector", fields: [inspectedById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  payments         Payment[]
  consents         Consent[]

  @@index([eventId, status])
  @@index([eventCategoryId, status])
  @@index([pilotId])
  @@map("registrations")
}

/// Cobrança Pix de uma inscrição. Uma inscrição pode ter várias (o Pix venceu e o piloto gerou
/// outro). Quem marca PAGO é o webhook do gateway, nunca o front (docs/arquitetura.md §5.5).
model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  registrationId   String        @map("registration_id") @db.Uuid
  registration     Registration  @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  /// Gateway que emitiu a cobrança ("mercadopago"; "seed" nos dados fictícios de desenvolvimento).
  provider         String
  /// Id da cobrança no gateway (o webhook chega com ele).
  providerChargeId String        @map("provider_charge_id")
  amountCents      Int           @map("amount_cents")
  status           PaymentStatus @default(PENDING)
  /// Pix "copia e cola" (BR Code). O QR Code é desenhado a partir deste texto.
  pixCopyPaste     String        @map("pix_copy_paste")
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(3)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// Última consulta ao gateway: a tela "Aguardando pagamento" consulta no máximo de tempos em tempos.
  lastCheckedAt    DateTime?     @map("last_checked_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerChargeId])
  @@index([registrationId])
  @@map("payments")
}

/// Cada notificação recebida do gateway, guardada como chegou. O unique por evento do gateway
/// torna o webhook IDEMPOTENTE: a mesma notificação repetida é ignorada.
model PaymentWebhookEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@map("payment_webhook_events")
}

/// Registro de consentimento (LGPD): o quê, qual versão do texto, quando e de onde.
model Consent {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Inscrição em que o termo de responsabilidade foi aceito (nulo para a política de privacidade).
  registrationId  String?       @map("registration_id") @db.Uuid
  registration    Registration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  kind            ConsentKind
  /// Versão do texto aceito (ex.: "2026-11"), para saber exatamente o que foi mostrado.
  documentVersion String        @map("document_version")
  acceptedAt      DateTime      @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ip              String?
  userAgent       String?       @map("user_agent")

  @@index([userId])
  @@map("consents")
}

// ─── Fase 4: conta do Mercado Pago do contratante (OAuth) ─────────────────────────────────
// Decisões no ADR 0005 (docs/decisions/0005-mercado-pago-oauth.md).

/// Conta do Mercado Pago que RECEBE as inscrições, conectada pelo organizador via OAuth.
/// Single-tenant: existe no máximo UMA linha (id = 1). Os tokens ficam CRIPTOGRAFADOS
/// (AES-256-GCM, chave em PAYMENT_TOKEN_KEY): quem ler o banco não consegue cobrar em nome do contratante.
model MercadoPagoAccount {
  id                    Int       @id @default(1)
  /// Id do usuário (vendedor) no Mercado Pago.
  mpUserId              String    @map("mp_user_id")
  accessTokenEncrypted  String    @map("access_token_encrypted")
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  /// Chave pública (não é segredo).
  publicKey             String?   @map("public_key")
  scope                 String?
  /// false = credenciais de teste (sandbox).
  liveMode              Boolean   @map("live_mode")
  /// Validade do access token (180 dias); renovado com o refresh token antes de vencer.
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  connectedById         String?   @map("connected_by_id") @db.Uuid
  connectedBy           User?     @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt           DateTime  @default(now()) @map("connected_at") @db.Timestamptz(3)
  refreshedAt           DateTime? @map("refreshed_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("mercado_pago_accounts")
}

/// Tentativa de conexão OAuth em andamento. O `state` enviado ao Mercado Pago só existe aqui como
/// HASH; vale 10 minutos, é de quem iniciou e só pode ser usado uma vez (contra CSRF no retorno).
model OAuthState {
  /// SHA-256 (hex) do state.
  id           String   @id
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PKCE: o segredo que prova, na troca do código, que fomos nós que iniciamos o fluxo.
  codeVerifier String   @map("code_verifier")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("oauth_states")
}
