{
  "name": "mxpro",
  "private": true,
  "description": "Plataforma de Gestão de Provas Off-Road",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @mxpro/db generate",
    "db:migrate": "pnpm --filter @mxpro/db migrate",
    "db:seed": "pnpm --filter @mxpro/db seed",
    "db:studio": "pnpm --filter @mxpro/db studio",
    "postinstall": "pnpm --filter @mxpro/db generate",
    "dev:api": "pnpm --filter @mxpro/api dev",
    "dev:web": "pnpm --filter web dev",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "angular-eslint": "~22.6.0",
    "eslint": "~10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.2"
  }
}
