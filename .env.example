# Copie para .env e ajuste. O .env NUNCA vai para o repositório.

# Banco (docker-compose.yml expõe o Postgres na porta 5433)
DATABASE_URL="postgresql://mxpro:mxpro_dev@localhost:5433/mxpro?schema=public"

# Senha dos usuários FICTÍCIOS criados pelo seed (só desenvolvimento; o seed se recusa a rodar em produção)
SEED_PASSWORD="mxpro-dev-2026"

# API (apps/api)
HOST="127.0.0.1"
PORT=3000
# Origens do front autorizadas (CORS), separadas por vírgula. Obrigatório em produção.
CORS_ORIGINS="http://localhost:4200"
LOG_LEVEL="info"
# Validade da sessão de login sem uso, em horas (renova sozinha enquanto o usuário usa o sistema).
SESSION_TTL_HOURS=12

# Banco usado pelos testes de integração da API (criado/migrado automaticamente; o nome deve conter "test").
TEST_DATABASE_URL="postgresql://mxpro:mxpro_dev@localhost:5433/mxpro_test?schema=public"

# Mercado Pago (ADR 0005). Credenciais do APLICATIVO criado em "Suas integrações" do Mercado Pago.
# A conta que recebe os Pix é a do contratante, conectada pelo organizador na tela Financeiro (OAuth).
# Deixe as cinco vazias para desligar a integração; configurar só algumas é erro.
# MP_CLIENT_ID=""
# MP_CLIENT_SECRET=""
# URL de retorno: precisa ser IGUAL à cadastrada no aplicativo (Mercado Pago > Suas integrações > URLs de redirecionamento).
# MP_REDIRECT_URI="https://seudominio.com.br/api/payments/mercadopago/callback"
# Assinatura secreta dos webhooks (Mercado Pago > Suas integrações > Webhooks). Cadastre lá a URL
# https://seudominio.com.br/api/payments/mercadopago/webhook com o evento "Order (Mercado Pago)".
# MP_WEBHOOK_SECRET=""
# "true" = pede credenciais de TESTE (sandbox) ao conectar.
MP_TEST_MODE="false"
# Chave que criptografa os tokens no banco (32 bytes em base64). Gere com: openssl rand -base64 32
# Trocar a chave invalida a conexão salva (será preciso conectar de novo).
# PAYMENT_TOKEN_KEY=""
